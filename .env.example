# Sufra environment template.
# Copy to .env.local for local overrides. Never commit real keys:
# .env and .env.local are excluded via .gitignore.

# Optional: USDA FoodData Central REST API key (data.gov signup).
# NOT required for the bundled catalogs. Set this only if an
# optional REST import flow is added later.
USDA_FDC_API_KEY=

# Optional: contact email embedded in the Open Food Facts User-Agent
# (format: Sufra/<app-version> (<contact>)) when a barcode lookup feature is
# wired up. Open Food Facts read operations require no API key.
OPEN_FOOD_FACTS_CONTACT=

# Note: TheMealDB's developer test key "1" is public and not a secret; it is
# limited to development/educational use. Public release requires supporter
# access (see assets/data/data_sources.json).
