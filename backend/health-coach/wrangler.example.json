{
  "name": "sufra-coach",
  "main": "owner-entry.mjs",
  "account_id": "<your-cloudflare-account-id>",
  "compatibility_date": "2026-11-24",
  "ai": { "binding": "AI" },
  "vars": {
    "ENABLED": "true",
    "FIREBASE_PROJECT_ID": "<your-firebase-project-id>",
    "ALLOWED_UIDS": "*"
  },
  "ratelimits": [
    { "name": "USER_LIMITER", "namespace_id": "<your-namespace-id>", "simple": { "limit": 4, "period": 60 } }
  ]
}
